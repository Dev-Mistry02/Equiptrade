# Leave this as /api for local development. Vite proxies it to localhost:4000.
VITE_API_URL=/api

# For a deployed frontend, set this to:
# VITE_API_URL=https://equiptrade-backend.onrender.com/api

# Cloudinary settings used by the Sell page.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
